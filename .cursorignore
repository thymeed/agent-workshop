# Cursor agent/index exclusions beyond .gitignore.
# .gitignore already covers indexing; .cursorignore also blocks Agent/Tab/@ access.

# --- secrets / credentials ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# --- dependencies & build ---
node_modules/
dist/
out/
build/
release/
*.asar
win-unpacked/
mac/
linux-unpacked/
*.exe
*.dmg
*.AppImage
*.blockmap
*.nsis.7z

# --- logs / caches / local tooling ---
*.log
npm-debug.log*
.cache/
.eslintcache
coverage/
.codewhale/
.cursor-event-log/
*.event-log.jsonl
event-log.jsonl

# --- OS junk ---
.DS_Store
Thumbs.db
Desktop.ini
