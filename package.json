{
  "name": "agent-workshop",
  "version": "1.3.0",
  "description": "Cursor Agents · Model Routing. Electron desktop dashboard with in-process live bridge",
  "main": "electron/main.js",
  "author": "Thymeed",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thymeed/agent-workshop.git"
  },
  "scripts": {
    "start": "electron .",
    "bridge": "node live-bridge.js",
    "build": "electron-builder && node scripts/copy-exe.js",
    "build:check": "node scripts/check-packaging.js",
    "copy-exe": "node scripts/copy-exe.js",
    "pack": "electron-builder --win portable && node scripts/copy-exe.js",
    "pack:win": "electron-builder --win && node scripts/copy-exe.js",
    "pack:mac": "electron-builder --mac && node scripts/copy-exe.js",
    "pack:linux": "electron-builder --linux && node scripts/copy-exe.js",
    "pack:dir": "electron-builder --dir",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checksums": "node scripts/checksums.js",
    "test": "node test/demo-smoke.test.js && node test/bridge-localhost.test.js && node test/bridge-guards.test.js && node test/insights-smoke.test.js && node test/event-log.test.js && node test/history-api.test.js && node test/transcript-history.test.js && node test/cards-smoke.test.js && node test/paths-windows.test.js && node test/bridge-test-guard.test.js && node test/dashboard-units.test.js && node test/electron-smoke.test.js && npm run test:unit",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "ci": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^26.6.5",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "playwright": "^1.51.0",
    "prettier": "^3.5.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.cursor.agents.model-routing",
    "productName": "Cursor Agents Model Routing",
    "copyright": "Copyright © thymeed",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "live-bridge.js",
      "lib/**/*",
      "model-routing-dashboard.html",
      "dashboard/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cursor Agents Model Routing"
    },
    "portable": {
      "artifactName": "AgentWorkshop.exe"
    },
    "afterAllArtifactBuild": "./scripts/copy-exe.js"
  }
}
